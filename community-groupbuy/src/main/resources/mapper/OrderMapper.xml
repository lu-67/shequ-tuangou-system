<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.community.groupbuy.mapper.OrderMapper">

    <!-- 手写动态 SQL（条件可选）：状态 / 活动 / 用户 / 订单号；供「我的订单」与统计导出复用 -->
    <select id="selectByCondition" parameterType="com.community.groupbuy.dto.OrderQueryDTO"
            resultType="com.community.groupbuy.entity.GroupOrder">
        SELECT * FROM group_order
        <where>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="activityId != null">
                AND activity_id = #{activityId}
            </if>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no LIKE CONCAT('%', #{orderNo}, '%')
            </if>
        </where>
        ORDER BY id
    </select>

</mapper>
