<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.community.groupbuy.mapper.PickupPointMapper">

    <sql id="pointColumns">
        id, name, address, manager, phone, create_time
    </sql>

    <!-- M5 动态查询：名称可选模糊，居民端首页不传条件即返回全部自提点 -->
    <select id="selectByCondition" resultType="com.community.groupbuy.entity.PickupPoint">
        SELECT <include refid="pointColumns"/>
        FROM pickup_point
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
        ORDER BY id ASC
    </select>

    <!-- M5 新增自提点，主键回填 -->
    <insert id="insert" parameterType="com.community.groupbuy.entity.PickupPoint"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pickup_point(name, address, manager, phone)
        VALUES(#{name}, #{address}, #{manager}, #{phone})
    </insert>

</mapper>
